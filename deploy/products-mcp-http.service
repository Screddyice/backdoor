# Account-synced products MCP bridge. Install as the hermes user service.
#
# Credentials stay in their existing deployment files. This unit reads those
# files in place and overrides only public connector settings.
[Unit]
Description=Products MCP bridge for Claude mobile and web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/hermes-mcp/http.env
EnvironmentFile=%h/.hermes/.env
EnvironmentFile=/root/engagemate/src/deploy/.env.api
# systemd applies EnvironmentFile values after Environment entries. Load the
# products overrides last so the shared Hermes file cannot restore port 8000
# or the Hermes OAuth issuer.
EnvironmentFile=%h/backdoor-products-mcp/deploy/products-mcp-runtime.env
WorkingDirectory=%h/backdoor-products-mcp
ExecStart=%h/backdoor-products-mcp/.venv/bin/python -m src.products_mcp.server
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=append:%h/logs/products-mcp-http.log
StandardError=append:%h/logs/products-mcp-http.log

[Install]
WantedBy=default.target
