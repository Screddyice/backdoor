# Public runtime settings for the account-synced HyperCrawl MCP service.
# Keep credentials in %h/.config/products-mcp/hypercrawl.env.
PRODUCTS_MCP_PRODUCT=hypercrawl
HYPERCRAWL_URL=https://136.119.211.135.nip.io/v1
HERMES_MCP_OAUTH_ISSUER=https://hypercrawl-mcp.teamnebula.ai
HERMES_MCP_OAUTH_STATE_PATH=/home/hermes/.config/products-mcp/hypercrawl-oauth-state.json
# Composio Custom MCP registers an OAuth client with a callback on backend.composio.dev.
HERMES_MCP_OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1,backend.composio.dev
HERMES_MCP_ALLOWED_HOSTS=hypercrawl-mcp.teamnebula.ai,hypercrawl-mcp.teamnebula.ai:443
HERMES_MCP_HOST=127.0.0.1
HERMES_MCP_PORT=8011
