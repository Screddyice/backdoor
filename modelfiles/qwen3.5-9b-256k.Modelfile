# qwen3.5:9b-256k — Qwen3.5 9B with the full native 256K context baked in.
# Needed for full-MCP sessions: ~50K harness prompt + ~148K global MCP tool
# schemas + conversation headroom blows past the 128K variant.
# KV cache at 256K (q8_0, per LaunchAgent) roughly doubles the 128K footprint —
# fits on the 36GB M5 Max but leaves little headroom; keep the 128K variant as
# the default for MCP-off sessions.
# Build: ollama create qwen3.5:9b-256k -f modelfiles/qwen3.5-9b-256k.Modelfile
FROM qwen3.5:9b
PARAMETER num_ctx 262144
