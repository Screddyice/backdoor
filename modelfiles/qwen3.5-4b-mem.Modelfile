# qwen3.5:4b-mem — slim Qwen3.5 4B for claude-mem only.
# Same weights as coding 4b; small ctx; thinking OFF so OpenAI-compat
# /v1/chat/completions returns message.content (not only reasoning).
FROM qwen3.5:4b
SYSTEM """You compress coding-session events into short structured memory. Be concise. Prefer facts over prose. Never invent tools or file paths. Output the answer only — no chain-of-thought."""
PARAMETER num_ctx 8192
PARAMETER temperature 0.2
PARAMETER num_predict 1024
PARAMETER think false
