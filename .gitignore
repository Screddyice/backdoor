.env
*.pyc
__pycache__/
# No trailing slash: a worktree's .venv is often a symlink to the main
# checkout's, and `.venv/` matches directories only.
.venv
dist/
*.egg-info/
proxy.log
router.log

# Local run artifacts and scratch workspaces.
out/
workspace/
.DS_Store
.supercoder/
profiles/
.active
.proxy.pid
modal/__pycache__/
# Claude Harness - Ephemeral/Per-Session State
.claude-harness/sessions/
.claude-harness/memory/compaction-backups/
.claude-harness/memory/working/

# Claude Code - Local settings
.claude/settings.local.json
.claude-harness/.setup-stamp
.claude-harness/.verify-cache
# Regenerated by the claude-harness plugin in whatever checkout it runs in,
# from the plugin's own template. Tracking it meant every checkout carried a
# permanent modification — including the deployed one, where a dirty tree
# aborts scripts/deploy-router.sh at preflight.
.claude-harness/init.sh

# Git worktrees
.worktrees/
