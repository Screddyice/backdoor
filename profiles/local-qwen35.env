# local-qwen35 — fully offline. Claude Code -> backdoor -> Ollama -> local model.
# Default offline brain: Qwen3.5 9B (256K-native context, native tool-calling).
# Small enough (6.6GB) that the FULL harness prompt + long sessions fit easily.
# Uses the qwen3.5:9b-256k variant (num_ctx 262144 baked via Modelfile) so the
# global OLLAMA_CONTEXT_LENGTH=32768 (sized for the 32B) stays untouched.
# 256K (16GB loaded, 100% GPU on the 36GB M5 Max) is needed for full-MCP
# sessions: ~50K harness prompt + ~148K global MCP tool schemas + headroom.
# Requires `ollama serve` running and `ollama pull qwen3.5:9b` +
# `ollama create qwen3.5:9b-256k -f modelfiles/qwen3.5-9b-256k.Modelfile`.

PROVIDER_BASE_URL=http://localhost:11434/v1
# Dummy key — Ollama ignores it, but bd's guard rejects empty/placeholder values.
PROVIDER_API_KEY=ollama
PROVIDER_MODEL=qwen3.5:9b-256k

# Mirror the vendor defaults shipped in the model's Modelfile (temp 1.0,
# top_p 0.95, top_k 20, presence_penalty 1.5). Request-level params override
# Modelfile ones, so these must MATCH — don't reuse qwen2.5's 0.2 here (low
# temp causes repetition loops on the hybrid-reasoning qwen3.x models).
PROVIDER_MAX_TOKENS=16384
PROVIDER_TEMPERATURE=1.0
PROVIDER_TOP_P=0.95

# Thinking OFF for agentic use: qwen3.5 with thinking enabled intermittently
# ends a turn with reasoning ONLY (no visible text) → empty assistant message,
# and every turn pays the reasoning-token latency. Set to empty to re-enable
# thinking (the proxy will surface it as Anthropic thinking blocks, with a
# reasoning-only safety net), but expect slower turns.
PROVIDER_REASONING_EFFORT=none

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

# ── Request optimizations (also reduce local compute on a laptop) ────────────
SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5
