# local-failover-128k — failover escalation tier (NOT a default brain).
# Selected by the :8083 hybrid router's cloud→local failover ladder when the
# real Anthropic API is down AND the failed-over session is too big for the 4B's
# 64K window. Bigger window = pick the 9B tier that fits the session.
#
#   qwen3.5:9b-128k — ~131072 window; measured load ~12GB at
#   OLLAMA_NUM_PARALLEL=4 (q8_0 KV + flash attention keep KV small — the old
#   256K "thrash" was f16 KV / the 142K MCP prompt, not this config). Fits 36GB
#   individually; Ollama evicts idle models (5m keep-alive) to make room.
#
# This is a FAILOVER tier, deliberately breaking the "harness = 4B" rule because
# keeping a big session ALIVE (even slowly) beats truncating it. Not for
# interactive use — the ▶ Local model: qwen3.5:4b-64k (local-qwen35, full-hooks(harness+mem+loop)) — offline wrapper and `/model qwen` stay on the 4B.

PROVIDER_BASE_URL=http://localhost:11434/v1
PROVIDER_API_KEY=ollama
PROVIDER_MODEL=qwen3.5:9b-128k

# 256K-native, vendor sampling (must match the Modelfile — low temp loops).
PROVIDER_MAX_TOKENS=8192
PROVIDER_TEMPERATURE=1.0
PROVIDER_TOP_P=0.95
PROVIDER_REASONING_EFFORT=none

HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5
