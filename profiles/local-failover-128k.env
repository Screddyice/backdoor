# local-failover-128k — failover escalation tier (NOT a default brain).
# Selected by the :8083 hybrid router's cloud→local failover ladder when the
# real Anthropic API is down AND the failed-over session is too big for the 4B's
# 64K window. Bigger window = pick the tier that fits the session.
#
#   qwen3.5:4b-128k — ~131072 window on the 4B. Switched 9B→4B 2026-07-09: a 9B
#   cold-prefilling a 70K+ token offline session ran 3.5+ min/turn, which made
#   `/model qwen` unresponsive on a plane. The 4B prefills several times faster;
#   it loads at ~9GB at 128K (vs the 9B's ~12GB — KV-dominated at this window,
#   so the real win is prefill speed, not memory), fitting 36GB with headroom.
#
# All failover tiers are now the 4B, so a wrapper session and a failover session
# never force a slow 9B to coexist with the 4B (the memory blowup that stalled).

PROVIDER_BASE_URL=http://localhost:11434/v1
PROVIDER_API_KEY=ollama
PROVIDER_MODEL=qwen3.5:4b-128k

# 256K-native, vendor sampling (must match the Modelfile — low temp loops).
PROVIDER_MAX_TOKENS=8192
PROVIDER_TEMPERATURE=1.0
PROVIDER_TOP_P=0.95
PROVIDER_REASONING_EFFORT=none

HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5
