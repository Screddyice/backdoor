# local-qwen38-action — Qwen3.8-27B Action-Abliterated, MLX 4-bit, served by
# mlx_vlm.server on 127.0.0.1:8080. This was the default local brain from
# 2026-08-25 through 2026-08-28 and remains available as `qwen38-action`.
#
# WHAT YOU ARE RUNNING. The model card (ajsai47/qwen38-action-abliterated-research)
# documents a bounded refusal-direction ablation: 92.5% HarmBench direct-request
# ASR and StrongREJECT 0.7079 against the base model's 0.1167. Its own
# out-of-scope list names "unsupervised execution with destructive, financial,
# medical, legal, identity, credential, surveillance, or high-impact tools", and
# this tier now serves exactly that: offline failover, and the `model: qwen`
# subagents (local-explore, local-worker) that run unattended with
# Read/Edit/Write/Bash. Shawn made that call deliberately on 2026-08-25 after
# being shown the tradeoff twice. It is recorded here so the next reader does
# not have to reconstruct whether it was an accident.
#
# What that means in practice: the operator, not the model, is the control
# surface. Scoped tool permissions, the permission prompt, and review of what
# an unattended agent did are the things standing between a bad instruction and
# a bad outcome. The model card says the same thing in its deployment guidance.
#
# NOT LAZILY LOADED. Every other local tier is an Ollama tag that loads on first
# request. This one is a launchd job that is either up or absent, which would
# make failover fail exactly when nobody is watching. src/proxy/mlx_admin.py
# starts it on demand and falls back to local-fast (the 4B, MLX_FALLBACK_PROFILE
# in src/proxy/mlx_admin.py) when it will not come up, so an offline session
# still gets an answer. It fell back to local-failover-heavy until that 9B
# profile was removed on 2026-08-31 (#70).
#
# NOT OLLAMA. This is the one local tier that does not go through :11434. The
# artifact is MLX 4-bit safetensors, and Ollama's MLX engine ignores num_ctx and
# loads a 262144 window that grows toward 32GB — the bug that panicked this host
# twice (see modelfiles/bare/qwen3.8-27b-bare.Modelfile). mlx_vlm.server honors
# its own --max-kv-size, so the window is real. Consequences:
#   * Ollama keep-alive, residency tracking, and eviction do not apply here.
#     This server holds ~19GB for as long as it is loaded, and Ollama cannot
#     evict it to make room for the llm-jury council. Run `qwen38 stop` before
#     any fusion work.
#   * The server is NOT started on demand. `qwen38 start` first, or this route
#     returns a connection error. `qwen38 status` reports health.
#
# ARTIFACT. 14.98 GiB, MLX 4-bit affine RTN, group size 64, vision-capable
# (hence mlx_vlm rather than mlx_lm). Pulled from the private HF repo
# ajs-ai/Qwen3.8-27B-Action-Abliterated-MLX-4bit. Verify the local copy against
# its SOURCE_SHA256SUMS before trusting a swap.
#
# DAILY vs LONG. `qwen38 start` is 65,536 context / 8,192 output; `qwen38
# start-long` is 262,144 / 32,768 and is configured but NOT locally proven —
# upstream validated 261,888-token retrieval on an A100, not on this Mac. Long
# mode also wants 25 GiB free disk against daily's 15 GiB. This profile targets
# daily mode.

PROVIDER_BASE_URL=http://127.0.0.1:8080/v1
PROVIDER_API_KEY=mlx
# NOT a friendly alias. mlx_vlm.server resolves this field as a repo_id and
# will go to the Hub if it is not a path on disk: `qwen38-action` produced
# 'Repository Not Found for huggingface.co/api/models/qwen38-action'. It must
# be the exact path the server was launched with (see the LaunchAgent plist).
PROVIDER_MODEL=/Users/screddy/Models/Qwen3.8-27B-Action-Abliterated-MLX-4bit-v1
RUNTIME_PROFILE=local-qwen38-action

# Strip the harness on an explicit route, same as the other deliberate tiers.
# This matters more here than anywhere else: the model's own repo measured cold
# prefill at 50.4 tokens/s, so an unstripped ~29K-token harness is roughly a
# ten-minute first turn. Bare mode holds the prompt near 945 tokens.
ROUTE_BARE=true

# Vendor sampling for qwen3.8.
PROVIDER_MAX_TOKENS=8192
PROVIDER_TEMPERATURE=1.0
PROVIDER_TOP_P=0.95
PROVIDER_REASONING_EFFORT=none

# mlx_vlm.server ignores reasoning_effort (an Ollama-ism) and leaves <think>
# tags inline in content. Without this the first thing a qwen session shows is
# the model reasoning, then a bare </think>, then the real answer.
PROVIDER_STRIP_INLINE_THINKING=true

HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5

# Escalate off this tier when a session outgrows the budget. The server window
# is 65,536, but the bound here is a prefill-latency budget rather than a window:
# at the measured 50.4 tokens/s, 28,000 tokens is already ~9 minutes of cold
# prefill. The in-memory 12,288-token prefix cache makes follow-up turns in the
# same session much cheaper, which is why the first turn is the one to size for.
ROUTE_MAX_INPUT_TOKENS=28000
