# local-qwen38-obliterated — standalone Qwen3.8-27B OBLITERATED Q4_K_M GGUF.
#
# This is the default `qwen` and normal-size failover tier.  It uses Ollama's
# llama.cpp engine, the same serving path that worked for qwen3.8:27b-bare.
# Its Modelfile installs the stock Qwen tool contract.  Live OpenAI-endpoint
# checks require both ordinary answer text and serialized tool calls.

PROVIDER_BASE_URL=http://localhost:11434/v1
PROVIDER_API_KEY=ollama
PROVIDER_MODEL=qwen3.8:27b-obliterated
RUNTIME_PROFILE=local-qwen38-obliterated

ROUTE_BARE=true
ROUTE_MAX_INPUT_TOKENS=27000

# Hold the tier past ordinary think-time. The working set keeps a session's
# prefix byte-stable so each turn is a 5-10s append instead of a 26-136s cold
# prefill, but that only pays while Ollama still holds the cache — and the
# global OLLAMA_KEEP_ALIVE here is 5 minutes. Any pause longer than that
# silently re-imposes a full cold prefill, about 70-100s at an 18K working set.
#
# Ten minutes, not thirty: a resident 27B is 17 GB, and every minute it stays
# is a minute `llmjury solve` can collide with it, since Ollama caps by model
# count and not by bytes. Ten spans an active session and still returns the GPU.
PROVIDER_KEEP_ALIVE=10m

PROVIDER_MAX_TOKENS=4096
# The tag's num_ctx, in the model's own tokens (see modelfiles/). The working-set
# guard sizes against this, not the router's tiktoken estimate.
PROVIDER_CONTEXT_TOKENS=32768
PROVIDER_TEMPERATURE=0.2
PROVIDER_TOP_P=0.95
PROVIDER_REASONING_EFFORT=none

HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5
