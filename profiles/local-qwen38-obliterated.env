# local-qwen38-obliterated — standalone Qwen3.8-27B OBLITERATED Q4_K_M GGUF.
#
# This is the default `qwen` and normal-size failover tier.  It uses Ollama's
# llama.cpp engine, the same serving path that worked for qwen3.8:27b-bare.
# Its Modelfile installs the stock Qwen tool contract.  Live OpenAI-endpoint
# checks require both ordinary answer text and serialized tool calls.

PROVIDER_BASE_URL=http://localhost:11434/v1
PROVIDER_API_KEY=ollama
PROVIDER_MODEL=qwen3.8:27b-obliterated

ROUTE_BARE=true
ROUTE_MAX_INPUT_TOKENS=28000

PROVIDER_MAX_TOKENS=8192
PROVIDER_TEMPERATURE=0.2
PROVIDER_TOP_P=0.95
PROVIDER_REASONING_EFFORT=none

HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5
