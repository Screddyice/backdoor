# local-fast — fully offline, lightweight. For battery / low-RAM / on-the-go.
# Qwen3.5 4B at 64K (same build as local-qwen35): the snappiest local brain.
# (Was qwen2.5-coder:14b, which was never pulled, so `qwen fast` / `/model
# qwen-fast` 404'd at Ollama. Repointed 2026-06-18 to the 4B so the alias works
# AND stays a 4B even when /model-switched into a full-harness session.)
# Requires `ollama serve` + `ollama pull qwen3.5:4b` +
# `ollama create qwen3.5:4b-64k -f modelfiles/qwen3.5-4b-64k.Modelfile`.

PROVIDER_BASE_URL=http://localhost:11434/v1
PROVIDER_API_KEY=ollama
PROVIDER_MODEL=qwen3.5:4b-64k

# qwen3.x is hybrid-reasoning: keep temp/top_p at the vendor defaults (1.0/0.95)
# — qwen2.5's low temp (0.2) causes repetition loops here — and force thinking
# OFF (reasoning_effort=none) so turns don't end reasoning-only or pay the
# reasoning-latency tax. Mirrors local-qwen35.
PROVIDER_MAX_TOKENS=8192
# The tag's num_ctx, in the model's own tokens (see modelfiles/). The working-set
# guard sizes against this, not the router's tiktoken estimate.
PROVIDER_CONTEXT_TOKENS=65536
PROVIDER_TEMPERATURE=1.0
PROVIDER_TOP_P=0.95
PROVIDER_REASONING_EFFORT=none

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

# ── Request optimizations ────────────────────────────────────────────────────
SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5
