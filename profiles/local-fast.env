# local-fast — fully offline, lightweight. For battery / low-RAM / on-the-go.
# Qwen2.5-Coder 14B: ~9GB, snappy, leaves plenty of RAM for other apps.
# Requires `ollama serve` + `ollama pull qwen2.5-coder:14b`.

PROVIDER_BASE_URL=http://localhost:11434/v1
PROVIDER_API_KEY=ollama
PROVIDER_MODEL=qwen2.5-coder:14b

PROVIDER_MAX_TOKENS=8192
PROVIDER_TEMPERATURE=0.2
PROVIDER_TOP_P=0.9

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

# ── Request optimizations ────────────────────────────────────────────────────
SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5
