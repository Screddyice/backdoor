# local-failover-256k, the finite wide tier for a deliberate local route.
# Breaker-confirmed outage failover no longer selects this profile. Context
# virtualization must reduce outage requests under the 27B profile's ceiling.
#
#   qwen3.5:4b-256k — full 256K native window on the 4B. Switched 9B→4B
#   2026-07-09: a 9B prefilling a ~186K-token session ran ~5 min/turn and
#   returned HTTP 500. The 4B is several times faster; at 256K it loads at ~13GB
#   (vs the 9B's ~15GB — KV dominates at this window, so the real win is prefill
#   speed, not memory), fitting 36GB with headroom.
#
# The historical profile name remains stable for existing route configuration.

PROVIDER_BASE_URL=http://localhost:11434/v1
PROVIDER_API_KEY=ollama
PROVIDER_MODEL=qwen3.5:4b-256k

# 256K-native, vendor sampling (must match the Modelfile — low temp loops).
PROVIDER_MAX_TOKENS=8192
PROVIDER_TEMPERATURE=1.0
PROVIDER_TOP_P=0.95
PROVIDER_REASONING_EFFORT=none

# Idle residency after a failover request. Failover-only tier: nothing in
# MODEL_ROUTES reaches it, so nobody is mid-session with it loaded and there
# is no reload to punish. Ollama's global OLLAMA_KEEP_ALIVE (5m) is priced
# for a model you are using; this one is wanted only while the breaker is
# open, and the breaker closing already triggers an explicit unload. This is
# the backstop for the outage that ends without a clean close.
PROVIDER_KEEP_ALIVE=45s

HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5
