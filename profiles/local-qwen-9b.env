# local-qwen-9b — a STRONGER local brain (Qwen3.5 9B @ 64K) for subagents that
# need more reasoning than the 4B default, reached via the `qwen-9b` route on
# the :8083 hybrid router. Used by the `fusion` agent to orchestrate llm-jury
# (frame the task, derive the oracle) better than a 4B can.
#
# NOT the full-harness default (that stays the 4B per the "harness = 4B" rule).
# This is for scoped subagent work. ~10-12GB loaded @NUM_PARALLEL=4 (q8_0 KV +
# flash attention). When the fusion agent then runs the llm-jury council
# (phi4+gemma3+llama), Ollama evicts idle models to fit — expect a reload of
# this 9B when the agent resumes after the council call.

PROVIDER_BASE_URL=http://localhost:11434/v1
PROVIDER_API_KEY=ollama
PROVIDER_MODEL=qwen3.5:9b-64k

# 256K-native; vendor sampling (must match the Modelfile — low temp loops).
PROVIDER_MAX_TOKENS=16384
PROVIDER_TEMPERATURE=1.0
PROVIDER_TOP_P=0.95
PROVIDER_REASONING_EFFORT=none

HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5
