# local-coder — fully offline. Claude Code -> backdoor -> Ollama -> local model.
# Primary offline brain: Qwen2.5-Coder 32B (best local coding quality).
# Requires `ollama serve` running and the model pulled (ollama pull qwen2.5-coder:32b).
# Context window (32k) is set by the com.screddy.ollama LaunchAgent, not here.

PROVIDER_BASE_URL=http://localhost:11434/v1
# Dummy key — Ollama ignores it, but bd's guard rejects empty/placeholder values.
PROVIDER_API_KEY=ollama
PROVIDER_MODEL=qwen2.5-coder:32b

# Lower temperature = more reliable tool-calling / less drift for agentic coding.
PROVIDER_MAX_TOKENS=8192
PROVIDER_TEMPERATURE=0.2
PROVIDER_TOP_P=0.9

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

# ── Request optimizations (also reduce local compute on a laptop) ────────────
SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5
