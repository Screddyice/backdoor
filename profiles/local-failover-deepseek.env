# local-failover-deepseek — the default cloud→local failover tier (NOT a
# default brain). Selected by the :8083 hybrid router when this host is offline
# and the failed-over session, AFTER bare-mode stripping, fits a 32K window.
#
#   deepseek-r1:14b-bare — ~16GB resident on this 36GB M5 Max at
#   OLLAMA_NUM_PARALLEL=2 (9.0GB weights + ~6.3GB KV at 32K x 2 slots, q8_0 KV
#   + flash attention). See modelfiles/bare/deepseek-r1-14b-bare.Modelfile.
#
# Why a 14B here when the ladder spent a month on a 4B: the 2026-07-09 revert
# (9B → 4B) was a prefill-latency fix, not a memory fix — a 9B cold-prefilling a
# ~186K-token failed-over session ran ~5 min/turn and 500'd. Bare mode removes
# the reason those sessions were 186K tokens in the first place (system prompt +
# tool definitions + tool results + images), so the model can grow instead of
# shrink. Keep these two changes together: reverting bare mode without also
# reverting this profile re-arms exactly that regression on a larger model.
#
# REASONING_EFFORT=none is load-bearing, not cosmetic. deepseek-r1 is a
# reasoning model and will otherwise emit long <think> traces before answering,
# which is the same responsiveness problem the 9B was reverted for. Verify it
# still suppresses thinking after an Ollama upgrade.

PROVIDER_BASE_URL=http://localhost:11434/v1
PROVIDER_API_KEY=ollama
PROVIDER_MODEL=deepseek-r1:14b-bare

PROVIDER_MAX_TOKENS=8192
PROVIDER_TEMPERATURE=0.6
PROVIDER_TOP_P=0.95
PROVIDER_REASONING_EFFORT=none

HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5
