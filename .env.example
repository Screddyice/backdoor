# ── NVIDIA NIM ──────────────────────────────────────────────────────────────
# Get your free API key at: https://build.nvidia.com
NVIDIA_NIM_API_KEY=nvapi-...

# Model to use for all Claude Code requests
# Free-tier options: meta/llama-3.3-70b-instruct, mistralai/mistral-large-2-instruct
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

# ── Request optimizations (reduce NIM quota usage) ───────────────────────────
SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

# ── Telegram (optional) ──────────────────────────────────────────────────────
# Create a bot via @BotFather, then paste the token here.
# Find your user ID via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# ── CLI sessions (Telegram integration) ──────────────────────────────────────
CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5
