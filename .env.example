# ── Provider — any OpenAI-compatible API ─────────────────────────────────────
#
# Examples:
#   NVIDIA NIM (free tier):   https://integrate.api.nvidia.com/v1
#   DeepSeek:                 https://api.deepseek.com/v1
#   Groq:                     https://api.groq.com/openai/v1
#   OpenRouter (200+ models): https://openrouter.ai/api/v1
#   Ollama (local):           http://localhost:11434/v1
#   LM Studio (local):        http://localhost:1234/v1
#
PROVIDER_BASE_URL=https://integrate.api.nvidia.com/v1
PROVIDER_API_KEY=your-api-key-here

# Model name as the provider expects it
# NIM:        meta/llama-3.3-70b-instruct
# DeepSeek:   deepseek-chat
# Groq:       llama-3.3-70b-versatile
# OpenRouter: meta-llama/llama-3.3-70b-instruct
PROVIDER_MODEL=meta/llama-3.3-70b-instruct

PROVIDER_MAX_TOKENS=32768
PROVIDER_TEMPERATURE=1.0
PROVIDER_TOP_P=1.0

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8082
LOG_FILE=proxy.log

# ── Codex Responses cloud-to-local failover (hybrid router on :8083) ────────
# Codex uses http://127.0.0.1:8083/backend-api/codex as a custom Responses
# provider. Healthy requests continue to ChatGPT; eligible failures use the
# local Qwen model with a fresh context recalled from Cognee.
CODEX_FAILOVER_TO_LOCAL=true
CODEX_CHATGPT_UPSTREAM=https://chatgpt.com/backend-api/codex
CODEX_FAILOVER_THRESHOLD=3
CODEX_FAILOVER_WINDOW_SECONDS=120
CODEX_FAILOVER_PROBE_SECONDS=60
CODEX_FAILOVER_STATUSES=429,500,502,503,504,529
CODEX_FAILOVER_REQUIRE_OFFLINE=false
CODEX_MAX_REQUEST_BYTES=67108864

CODEX_CONTEXT_WINDOW=32000
CODEX_REPLY_RESERVE_TOKENS=4000
CODEX_SYSTEM_BUDGET_TOKENS=1000
CODEX_MEMORY_BUDGET_TOKENS=2000
CODEX_TOOLS_BUDGET_TOKENS=4000
CODEX_ACTIVE_TURN_BUDGET_TOKENS=21000

CODEX_LOCAL_RESPONSES_URL=http://127.0.0.1:11434/v1/responses
CODEX_LOCAL_MODEL=qwen3.8:27b-obliterated
CODEX_LOCAL_TOOLS=local

# Shared with LLM-Jury. Claude and Codex routes publish a 10-minute ownership
# lease here before loading the exclusive 27B model.
BACKDOOR_COMPUTE_LEASE_DIR=~/.backdoor/compute-leases

COGNEE_BASE_URL=http://127.0.0.1:8001
CODEX_COGNEE_TIMEOUT_SECONDS=2
CODEX_COGNEE_TOP_K=8
CODEX_COGNEE_CHAR_BUDGET=8000
# Empty by default. Add comma-separated public URL prefixes only after review.
EXTERNAL_CONTEXT_PUBLIC_URL_PREFIXES=
# Optional. Backdoor also reads the existing ~/.cognee/.env and
# ~/.cognee-plugin/api_key.json stores, so launchd does not need a copied key.
# COGNEE_API_KEY=

# ── Request optimizations (reduce provider quota usage) ──────────────────────
SKIP_QUOTA_PROBES=true
SKIP_TITLE_GENERATION=true
SKIP_SUGGESTION_MODE=true
MOCK_PREFIX_DETECTION=true
MOCK_FILEPATH_EXTRACTION=true

# ── Telegram (optional) ──────────────────────────────────────────────────────
# Uncomment and fill in to enable the Telegram bot.
# Create a bot via @BotFather, find your user ID via @userinfobot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_ID=

# ── CLI sessions (Telegram integration) ──────────────────────────────────────
CLAUDE_WORKSPACE=./workspace
MAX_CLI_SESSIONS=5

# ── CONNECT forward proxy (optional; hybrid mode) ────────────────────────────
# Lets one session have BOTH offline failover and Claude Code's Remote Control.
# Claude Code only offers Remote Control when ANTHROPIC_BASE_URL is unset or
# points at api.anthropic.com, so instead of naming the router as the base URL,
# point HTTPS_PROXY at this proxy and leave the base URL alone:
#
#   env -u ANTHROPIC_BASE_URL \
#       HTTPS_PROXY=http://127.0.0.1:8084 \
#       NODE_EXTRA_CA_CERTS=~/.backdoor/ca/ca-cert.pem \
#       claude
#
# Only FORWARD_MITM_HOSTS are TLS-terminated and handed to the router; every
# other host is tunnelled as opaque bytes. Enabling this mints a local CA under
# FORWARD_CA_DIR — it is never added to the system keychain, so only processes
# given NODE_EXTRA_CA_CERTS trust it. See "Forward-proxy mode" in the README.
# FORWARD_PROXY=false
# FORWARD_HOST=127.0.0.1
# FORWARD_PORT=8084
# FORWARD_MITM_HOSTS=api.anthropic.com
# FORWARD_ROUTER_HOST=127.0.0.1
# Set explicitly when uvicorn is launched with --port; that flag never reaches
# Settings, so PORT above will not reflect it.
# FORWARD_ROUTER_PORT=8083
# FORWARD_IDLE_TIMEOUT=660
# FORWARD_MAX_CONNECTIONS=512
# FORWARD_CA_DIR=~/.backdoor/ca
