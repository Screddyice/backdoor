#!/usr/bin/env bash
# qwen: launch Claude Code against a local Qwen model.
# (alias: claude-local)
#
#   Claude Code  ->  backdoor proxy (:8082)  ->  Ollama (:11434)  ->  local model
#
# Inference runs on-device. Local work remains available without internet;
# WebSearch, WebFetch, and public HTTP calls can use a live connection.
#
# Modes (default changed 2026-08-28 to the obliterated 27B GGUF):
#   qwen            LEAN (default, 2026-07-09). Minimal prompt (~945 tok) on
#                   Qwen3.8 OBLITERATED 27B @ 32K: --bare, harness commands,
#                   no auto hooks, MCP off. The 27B is affordable here ONLY
#                   because lean keeps the prompt tiny; 23GB resident, so it
#                   cannot co-reside with the fusion council (~21GB) on this
#                   36GB host (see keep_alive below). Full mode's ~42K harness prefill made a cold 4B take
#                   minutes (and stall entirely under memory pressure), so lean
#                   is the default — that offline hang is exactly why it flipped.
#   qwen full       FULL harness — still Qwen3.5 4B @ 64K, NOT the 27B. The
#                   harness prompt is ~29K tokens and does not fit the 27B's 32K
#                   window with room left to converse. claude-harness hooks
#                   ACTIVE (claude-mem + ralph-loop dropped 2026-07-09 — their
#                   injection was the biggest chunk of the ~42K prompt).
#                   Still a minute+ cold prefill; use when you want the harness.
#                   MCP OFF by default (see below). 256K-native, no rope.
#   qwen fast       Lean on Qwen3.5 4B @ 64K — the snappiest local brain, and
#                   the escape hatch when the 27B is too heavy or too slow.
#                   (qwen coder / qwen2.5-coder removed 2026-07-04.)
#   qwen mcp NAME   Attach only the named ~/.claude.json MCP server for this
#                   session. NAME may be a comma-separated list. Use
#                   `qwen mcp list` to see valid names.
#   qwen [args...]  Extra args pass straight through to `claude`.
#
# The launch banner prints the resolved model — read it if you are unsure which
# tier you got. `/model qwen` inside a normal cloud session routes to the same
# 27B via the :8083 hybrid router, which strips the harness server-side
# (ROUTE_BARE); that is a separate path from this wrapper, which uses :8082.
#
# Env overrides:
#   QWEN_COGNEE=1  Cognee memory as a 2-tool MCP shim (small schema). ON BY
#               DEFAULT since 2026-08-22: a small window only works if durable
#               facts live outside it. Local Ollama inference + remote memory.
#               Needs COGNEE_API_KEY + network; no key degrades to empty MCP.
#   QWEN_COGNEE=0  force memory off (true-offline, zero network calls).
#               (QWEN_MEM0=1 is a deprecated alias — Mem0 was retired 2026-08-20.)
#   QWEN_MCP=0  (the default everywhere now) no MCP servers — true-offline,
#               fast. MCP schemas are big (~142K tokens for the global set; even
#               the curated stack overflows the 64K window) and were half of why
#               full mode crawled, so MCP is OFF by default in ALL modes.
#   QWEN_MCP=1  opt INTO MCP (any mode). Loads the curated stack
#               (whatever you list in QWEN_MCP_SERVERS) — needs internet,
#               and you'll want a bigger-context model tag (e.g. qwen3.5:4b-256k)
#               since the schemas don't fit 64K.
#   QWEN_MCP_SERVERS=a,b,c  override which ~/.claude.json servers to load
#               (keep it small: two servers is often ~12 tools).
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"   # bd + claude live here

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
if [ -f "$SCRIPT_DIR/local/qwen-mcp-config.py" ]; then
  QWEN_SOURCE="$SCRIPT_DIR"
else
  QWEN_SOURCE="$HOME/backdoor"
fi
QWEN_MCP_HELPER="$QWEN_SOURCE/local/qwen-mcp-config.py"

PROFILE=""    # empty = derive from the FINAL mode below
MODE="lean"   # default flipped full→lean 2026-07-09 (offline responsiveness)
MCP_REQUESTED=""
# Leading mode keywords (consume them; rest passes to claude).
while :; do
  case "${1:-}" in
    lean) MODE="lean"; shift ;;
    fast) PROFILE="local-fast"; MODE="lean"; shift ;;
    full) MODE="full"; shift ;;
    mcp)
      shift
      if [ "${1:-}" = "list" ]; then
        python3 "$QWEN_MCP_HELPER" list
        exit 0
      fi
      [ -n "${1:-}" ] || {
        echo "Usage: qwen mcp SERVER[,SERVER...] [lean|fast|full] [claude args...]" >&2
        echo "Run 'qwen mcp list' to see configured server names." >&2
        exit 2
      }
      MCP_REQUESTED="$1"
      shift
      ;;
    *) break ;;
  esac
done
[ "${QWEN_FULL:-0}" = "1" ] && MODE="full"
[ "${QWEN_LEAN:-0}" = "1" ] && MODE="lean"

if [ -n "$MCP_REQUESTED" ]; then
  python3 "$QWEN_MCP_HELPER" validate --servers "$MCP_REQUESTED"
  QWEN_MCP=1
  QWEN_MCP_SERVERS="$MCP_REQUESTED"

  # Use the router's certificate-verifying reachability probe. A targeted MCP
  # request should not hold startup open on SSH/HTTP timeouts when the Mac is
  # offline. QWEN_MCP_ASSUME_ONLINE is an operator escape hatch for networks
  # whose policy blocks both public probe endpoints while allowing the MCP.
  if [ "${QWEN_MCP_ASSUME_ONLINE:-0}" != "1" ] && ! \
      python3 "$QWEN_MCP_HELPER" online; then
    echo "qwen: internet unavailable; requested MCP skipped for this session" >&2
    QWEN_MCP=0
    QWEN_MCP_SERVERS=""
  fi
fi

# Resolve the profile from the FINAL mode, so env overrides that flip the mode
# (QWEN_FULL/QWEN_LEAN) cannot leave a profile that contradicts it. `fast` is
# the one explicit pin and wins outright.
#
# Default/lean is the GGUF 27B as of 2026-08-28. It is viable because lean mode
# passes --bare: the prompt is ~945 tokens against a 32K window. Full mode's
# ~29K harness prompt does NOT fit that window with room left to converse, so it
# stays on the 4B @ 64K — the tier the 2026-07-09 prefill revert chose for
# exactly this case. Do not "unify" these two onto the 27B without first giving
# the 27B a bigger window, and read the KV sizing note in
# modelfiles/bare/qwen3.8-27b-bare.Modelfile before you do.
if [ -z "$PROFILE" ]; then
  if [ "$MODE" = "full" ]; then
    PROFILE="local-qwen35"           # qwen3.5:4b-64k  — harness needs the window
  else
    PROFILE="local-qwen38-obliterated" # obliterated 27B GGUF on Ollama
  fi
fi

# Tell Claude Code the model's REAL window. It does not recognise the name
# "qwen", so it falls back to assuming 200K and auto-compact never fires until
# long after the local model's true window is blown: the transcript keeps
# growing, every turn re-prefills a context the model cannot hold, and the
# session crawls. Keep these equal to the profile's actual num_ctx (see
# modelfiles/bare/*.Modelfile). A value LARGER than the real window re-creates
# the bug, so do not round up. Explicit env wins, for one-off experiments.
case "$PROFILE" in
  # The GGUF tier serves 32K. The two 64K rollback tiers are held at 32K so
  # compaction fires near their 28K escalation bound.
  # Smaller than the real window is the safe direction (the warning above is
  # about rounding UP), and it keeps auto-compact firing just past the 28000
  # ROUTE_MAX_INPUT_TOKENS escalation bound both profiles carry. Raising it to
  # 64000 would park long sessions on the 4B 256K tier for the whole 28K-64K
  # stretch instead of compacting.
  local-qwen38-obliterated) QWEN_CTX=32000 ;; # GGUF 27B @ 32K
  local-qwen38-action) QWEN_CTX=32000 ;;    # MLX 27B @ 64K, held at 32K
  local-qwen35|local-fast) QWEN_CTX=64000 ;; # qwen3.5:4b-64k  @ 64K
  *) QWEN_CTX=32000 ;;                       # unknown profile: assume the floor
esac
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-$QWEN_CTX}"

# Claude Code reserves output space before it decides whether to compact. Its
# xhigh default reserves 20K for an unrecognised model, leaving only a 12K
# effective input window inside this profile's 32K context. The lean plugin and
# tool prefix can cross that line before the conversation starts. Match the
# provider cap so the client has 27,904 tokens available for input and compacts
# near the route's 27K escalation guard instead of on the first useful turn.
QWEN_MAX_OUTPUT_TOKENS="${CLAUDE_CODE_MAX_OUTPUT_TOKENS:-4096}"

# 1. Make sure the Ollama daemon is up (LaunchAgent normally keeps it alive).
if ! curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
  echo "Ollama daemon down — starting via LaunchAgent..."
  launchctl kickstart -k "gui/$(id -u)/com.screddy.ollama" 2>/dev/null \
    || launchctl load -w "$HOME/Library/LaunchAgents/com.screddy.ollama.plist" 2>/dev/null \
    || { echo "Falling back to manual ollama serve..."; nohup ollama serve >/tmp/ollama-serve.log 2>&1 & }
  for _ in $(seq 1 30); do
    curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && break; sleep 0.5
  done
fi

# 2. Verify the model for this profile is actually pulled (offline-ready).
#    Query the API with a small retry — `ollama list` can race a fresh daemon.
MODEL="$(grep -E '^PROVIDER_MODEL=' "$HOME/backdoor/profiles/$PROFILE.env" | cut -d= -f2-)"
if [ "$PROFILE" = "local-qwen38-action" ]; then
  # The MLX tier has no Ollama tag to find — PROVIDER_MODEL is a label the
  # mlx_vlm server answers to, and /api/tags will never list it. Checking for it
  # there would fail every launch. The readiness check that matters is whether
  # the weights are on disk; the server itself gets started further down.
  if [ ! -e "$HOME/Models/Qwen3.8-27B-Action-Abliterated-MLX-4bit-v1/config.json" ]; then
    echo "WARNING: the MLX artifact is not installed."
    echo "Run backdoor/local/install-qwen38.sh (see its header for the download), or"
    echo "use 'qwen fast' for an Ollama tier in the meantime."
    exit 1
  fi
else
  present=""
  for _ in 1 2 3 4 5; do
    # match "MODEL" or "MODEL:tag" in the API's JSON name field
    if curl -sf http://127.0.0.1:11434/api/tags 2>/dev/null | grep -qE "\"${MODEL}(:[^\"]*)?\""; then
      present=1; break
    fi
    sleep 1
  done
  if [ -z "$present" ]; then
    echo "WARNING: model '$MODEL' is not available yet."
    echo "Pull/build it WHILE ONLINE (see profiles/README-local.md), then retry."
    exit 1
  fi
fi

# 3. MCP defaults: OFF in every mode now. MCP tool schemas are huge (~142K
#    tokens for the global ~/.claude.json set; even the curated stack overflows
#    the 9b-64k window) and a giant schema prefill was half of why full mode
#    crawled. So default to no MCP; opt in with QWEN_MCP=1 (and switch to a
#    bigger-context tag like qwen3.5:4b-256k, since the schemas won't fit 64K).
#    When opted in, QWEN_MCP_SERVERS picks the servers (default: our own stack
#    — set QWEN_MCP_SERVERS to the ~/.claude.json servers you want).
MCP_DEFAULT=0
MCP_ARGS=()
# Cognee memory: ON by default (flipped from opt-in 2026-08-22). Inference stays
# local; store/search hit the Cognee instance. This is the ONE exception to the
# MCP-off rule above, and it earns it: the shim exposes exactly two tools, so the
# schema costs ~hundreds of tokens rather than the ~142K of the global set.
#
# Defaulting it on is the point, not a convenience. Without memory the local
# model has to carry every durable fact in-context, which is exactly what blows
# a 32K window and makes the session crawl; with it, facts live in the graph and
# the window stays short. Cognee Cloud exposes no hosted MCP endpoint (/mcp
# 404s) and the full cognee-mcp schema will not fit 64K, hence the stdio shim.
#
# Needs COGNEE_API_KEY + network. Both degrade safely: no key falls through to
# an empty MCP config below, so a genuinely offline run still works. Set
# QWEN_COGNEE=0 to force it off (true-offline, zero network calls).
COGNEE_DEFAULT=1
COGNEE_ENABLED="${QWEN_COGNEE:-${QWEN_MEM0:-$COGNEE_DEFAULT}}"
COGNEE_SHIM=""
if [ "$COGNEE_ENABLED" = "1" ]; then
  if [ -n "${QWEN_MEM0:-}" ] && [ "${QWEN_MEM0:-0}" = "1" ] && [ -z "${QWEN_COGNEE:-}" ]; then
    echo "qwen: QWEN_MEM0 is deprecated (Mem0 retired 2026-08-20) — using Cognee; set QWEN_COGNEE=1" >&2
  fi
  # Ensure creds are available (env wins, then ~/.cognee/.env, then ~/projects/.env).
  if [ -z "${COGNEE_API_KEY:-}" ] && [ -f "$HOME/.cognee/.env" ]; then
    set -a
    # shellcheck disable=SC1090
    source "$HOME/.cognee/.env"
    set +a
  fi
  if [ -z "${COGNEE_API_KEY:-}" ] && [ -f "$HOME/projects/.env" ]; then
    set -a
    # shellcheck disable=SC1090
    source "$HOME/projects/.env"
    set +a
  fi
  [ -n "${COGNEE_API_KEY:-}" ] && COGNEE_SHIM="$HOME/.claude/scripts/cognee-mcp-shim.py"
fi

if [ "$COGNEE_ENABLED" = "1" ] && [ "${QWEN_MCP:-$MCP_DEFAULT}" != "1" ]; then
  if [ -n "${COGNEE_API_KEY:-}" ]; then
    COGNEE_MCP_CONF="$HOME/.cache/backdoor/qwen-cognee-mcp.json"
    mkdir -p "$(dirname "$COGNEE_MCP_CONF")"
    # The shim reads creds from its own env/~/.cognee/.env, so unlike the Mem0
    # config this file holds NO secret — but keep it 600 anyway, since the path
    # is shared with configs that do.
    (
      umask 077
      python3 - "$COGNEE_MCP_CONF" <<'PY2'
import json, sys, os
path = sys.argv[1]
cfg = {
  "mcpServers": {
    "cognee": {
      "type": "stdio",
      "command": "python3",
      "args": [os.path.expanduser("~/.claude/scripts/cognee-mcp-shim.py")],
    }
  }
}
json.dump(cfg, open(path, "w"), indent=2)
PY2
    )
    chmod 600 "$COGNEE_MCP_CONF"
    MCP_ARGS=(--strict-mcp-config --mcp-config "$COGNEE_MCP_CONF")
    echo "qwen: Cognee memory MCP enabled (cloud memory, local inference)" >&2
  else
    echo "qwen: QWEN_COGNEE=1 but COGNEE_API_KEY unset — MCP empty" >&2
    MCP_ARGS=(--strict-mcp-config --mcp-config "$HOME/backdoor/empty-mcp.json")
  fi
elif [ "${QWEN_MCP:-$MCP_DEFAULT}" != "1" ]; then
  MCP_ARGS=(--strict-mcp-config --mcp-config "$HOME/backdoor/empty-mcp.json")
else
  # Regenerated every launch from ~/.claude.json so key rotations carry over.
  # Lives in ~/.cache (NOT the backdoor repo) because it contains API keys.
  MCP_CONF="$HOME/.cache/backdoor/qwen-mcp.json"
  mkdir -p "$(dirname "$MCP_CONF")"
  # umask 077 so the file is created 600 from its first byte (see the Mem0
  # branch above for why the chmod below stays as a backstop, not a duplicate).
  COGNEE_BUILD_ARGS=()
  [ -n "$COGNEE_SHIM" ] && COGNEE_BUILD_ARGS=(--cognee-shim "$COGNEE_SHIM")
  python3 "$QWEN_MCP_HELPER" build --servers "${QWEN_MCP_SERVERS:-}" \
    --output "$MCP_CONF" ${COGNEE_BUILD_ARGS[@]+"${COGNEE_BUILD_ARGS[@]}"}
  chmod 600 "$MCP_CONF"
  MCP_ARGS=(--strict-mcp-config --mcp-config "$MCP_CONF")
fi

# Optional: reach the Hermes MCP bridge from this local model. Independent of
# QWEN_COGNEE/QWEN_MCP above — when set it takes over MCP_ARGS with just the
# hermes-mcp server. Regenerated every launch (mode 600, under ~/.cache, not
# the repo) so key rotations carry over; a missing URL/key degrades to a
# warning rather than a failed launch.
if [ "${QWEN_HERMES:-0}" = "1" ]; then
  if [ -z "${HERMES_MCP_URL:-}" ] || [ -z "${HERMES_MCP_KEY:-}" ]; then
    echo "qwen: QWEN_HERMES=1 but HERMES_MCP_URL/HERMES_MCP_KEY are unset — MCP stays off" >&2
  else
    HERMES_CFG="$HOME/.cache/backdoor/qwen-hermes-mcp.json"
    mkdir -p "$(dirname "$HERMES_CFG")"
    # Expand env into a private config (mode 600) — Claude Code's MCP config
    # may not expand ${ENV} references at load time. umask 077 so the file
    # is created 600 from its first byte (chmod below stays as a backstop —
    # see the Mem0 branch above for why it isn't redundant).
    (
      umask 077
      python3 - "$HERMES_CFG" <<'PY3'
import json, os, sys
cfg = {"mcpServers": {"hermes-mcp": {
    "type": "http",
    "url": os.environ["HERMES_MCP_URL"],
    "headers": {"Authorization": "Bearer " + os.environ["HERMES_MCP_KEY"]},
}}}
json.dump(cfg, open(sys.argv[1], "w"), indent=2)
PY3
    )
    chmod 600 "$HERMES_CFG"
    MCP_ARGS=(--strict-mcp-config --mcp-config "$HERMES_CFG")
    echo "qwen: Hermes MCP bridge enabled" >&2
  fi
fi

# 4. Mode-specific launch args.
if [ "$MODE" = "full" ]; then
  # AUTO-HOOK mode: enable harness + claude-mem + ralph-loop (and their hooks),
  # disable the other heavy plugins so the prompt (~29K) stays manageable.
  EXTRA_ARGS=(--settings "$HOME/backdoor/hook-mode.settings.json")
  if [ -n "${QWEN_MCP_SERVERS:-}" ]; then
    EXTRA_ARGS+=(--append-system-prompt "MCP servers attached for this session: ${QWEN_MCP_SERVERS}. Use only the attached MCP tools needed for the request.")
  fi
  MODE_NOTE="full-hooks(harness)"
else
  # LEAN mode: --bare skips the heavy plugin/hook auto-injection (~30K tokens);
  # --plugin-dir re-adds claude-harness so its commands stay available on demand.
  EXTRA_ARGS=(--bare)
  HARNESS_DIR="$(ls -dt "$HOME"/.claude/plugins/cache/claude-harness/claude-harness/*/ 2>/dev/null | head -1)"
  [ -n "$HARNESS_DIR" ] && EXTRA_ARGS+=(--plugin-dir "$HARNESS_DIR")

  # --bare also skips CLAUDE.md auto-discovery and EVERY hook. `claude --help`
  # says so outright, and a SessionStart probe confirmed it on 2026-08-15: the
  # hook fired without --bare and did not fire with it, and --settings cannot
  # put it back.
  #
  # That quietly removed both halves of PR creation from local-model sessions.
  # The model never saw the every-branch-gets-a-PR rule (it lives in CLAUDE.md),
  # and auto-pr-push.sh never fired to do it on the model's behalf. The branch
  # got commits, nothing opened a PR, and nothing said why.
  #
  # Re-inject the git/PR rules only. Loading the real CLAUDE.md set via
  # --add-dir would work but costs ~33KB — a quarter of the 27B's 32K window,
  # for context that is mostly irrelevant to a local coding turn. `--append-
  # system-prompt` takes the text inline; there is no `-file` form despite what
  # the --bare help text implies.
  PR_RULES="$HOME/backdoor/prompts/qwen-pr-rules.md"
  ONLINE_RULES="$HOME/backdoor/prompts/qwen-online-tools.md"
  LEAN_RULES=""
  [ -f "$PR_RULES" ] && LEAN_RULES="$(cat "$PR_RULES")"
  if [ -f "$ONLINE_RULES" ]; then
    LEAN_RULES="${LEAN_RULES}${LEAN_RULES:+$'\n\n'}$(cat "$ONLINE_RULES")"
  fi
  if [ -n "${QWEN_MCP_SERVERS:-}" ]; then
    LEAN_RULES="${LEAN_RULES}${LEAN_RULES:+$'\n\n'}MCP servers attached for this session: ${QWEN_MCP_SERVERS}. Use only the attached MCP tools needed for the request."
  fi
  [ -n "$LEAN_RULES" ] && EXTRA_ARGS+=(--append-system-prompt "$LEAN_RULES")

  MODE_NOTE="lean"
fi

# Keep Claude Code's context accounting on the local alias even when the saved
# user setting names a cloud model. A later --model in "$@" remains available
# as an explicit caller override.
EXTRA_ARGS+=(--model qwen)

# 5. Point backdoor at the profile, ensure the proxy is up, then exec `claude`
#    DIRECTLY (not `bd claude`, which cd's into the backdoor repo and breaks
#    file paths) so it runs in YOUR current directory.
bd switch "$PROFILE" >/dev/null
bd start >/dev/null 2>&1
PORT="$(grep -E '^PORT=' "$HOME/backdoor/.env" 2>/dev/null | tail -1 | cut -d= -f2-)"; PORT="${PORT:-8082}"
# bd switch/start can restart the proxy and return before uvicorn is listening;
# launching claude into that gap = instant "API Error: Connection error"
# (fatal in -p mode). Wait for /health before exec.
proxy_up=""
for _ in $(seq 1 30); do
  if curl -sf "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then proxy_up=1; break; fi
  sleep 0.5
done
[ -z "$proxy_up" ] && { echo "ERROR: backdoor proxy on :$PORT never became healthy — check ~/backdoor/proxy.log"; exit 1; }

# 5b. Warm the model NOW (backgrounded) so the first real turn skips the cold
# load (~1.2s) — it finishes while Claude Code's node startup runs. The tiny
# SYSTEM message is REQUIRED: a systemless call falls through to the baked ~46K
# Fable-5 SYSTEM prompt and cold-prefills all of it (~60s) — the exact trap that
# looked like an offline hang. keep_alive 30m holds it warm for the session
# (still unloads afterward, so battery use on a plane stays bounded).
#
# keep_alive is shorter for the 27B on purpose. At 17GB resident it and a
# fusion council (~21GB) cannot both be loaded on this 36GB host — 44GB against
# a ~27GB Metal wired ceiling — and OLLAMA_MAX_LOADED_MODELS caps by model
# COUNT, not bytes, so nothing upstream will refuse that combination. Holding a
# 27B warm for 30 idle minutes widens the window where `llmjury solve` collides
# with it; 10 minutes still covers an active session while giving the GPU back
# sooner. This comment said ~15GB until 2026-08-14, which was the int4 build's
# lazily-allocated floor; the GGUF rebuild (PR #23) made the real number 23GB
# and the collision correspondingly worse. The qwen3.8 swap on 2026-08-16
# measured 17GB, so the collision eased, but a ~21GB council still does not fit
# beside it under the ~27GB wired ceiling. Keep the 10m. See the panic note in
# modelfiles/bare/qwen3.8-27b-obliterated.Modelfile.
#
# The MLX tier is the exception to all of the above. It is not an Ollama tag, so
# there is no keep_alive to clamp and no lazy load to warm: the server is either
# running or it is not. Start it in the foreground instead, because a `qwen`
# session that races a 15GiB weight load just fails its first turn. The router
# does the same thing on its own path (src/proxy/mlx_admin.py) for sessions that
# never touch this wrapper.
if [ "$PROFILE" = "local-qwen38-action" ]; then
  if command -v qwen38 >/dev/null 2>&1; then
    qwen38 start || {
      echo "qwen: MLX server would not start; the router will fall back to the 9B." >&2
    }
  else
    echo "qwen: qwen38 helper not on PATH — run backdoor/local/install-qwen38.sh." >&2
  fi
else
  KEEP_ALIVE="30m"
  WARM_OLLAMA=1
  [ "$PROFILE" = "local-qwen38-obliterated" ] && KEEP_ALIVE="10m"
  if [ "$PROFILE" = "local-qwen38-obliterated" ]; then
    if ! command -v qwen38 >/dev/null 2>&1 || ! qwen38 stop; then
      WARM_OLLAMA=""
      echo "qwen: MLX could not be stopped; skipping the direct 27B warmup so the router can fall back safely." >&2
    fi
  fi
  [ -n "$WARM_OLLAMA" ] && curl -s -o /dev/null "http://127.0.0.1:11434/api/chat" \
    -d "{\"model\":\"$MODEL\",\"keep_alive\":\"$KEEP_ALIVE\",\"options\":{\"num_predict\":1},\"messages\":[{\"role\":\"system\",\"content\":\"warmup\"},{\"role\":\"user\",\"content\":\"hi\"}]}" \
    >/dev/null 2>&1 &
fi

if [ "${MCP_ARGS[2]:-}" = "$HOME/backdoor/empty-mcp.json" ]; then
  MCP_NOTE="offline"
else
  MCP_NOTE="MCP: ${QWEN_MCP_SERVERS:-<none set>} (net)"
fi
echo "▶ Local model: $MODEL ($PROFILE, $MODE_NOTE) — $MCP_NOTE"
# API_TIMEOUT_MS: a cold 50K-token full-harness prefill takes ~2-3 min on the
# 9B; Claude Code's default timeout aborts + retries mid-prefill, doubling it.
# ${arr[@]+...} guards: macOS bash 3.2 + `set -u` errors on expanding an
# empty array; MCP_ARGS is empty whenever MCP is on.
#
# Not `exec`, deliberately. Replacing this shell would leave nothing to run
# AFTER the session, and --bare disables hooks — including the Stop hook that
# normally guarantees a branch does not end the day without a PR. Dropping exec
# costs one idle shell and buys back that backstop (step 7).
env ANTHROPIC_BASE_URL="http://127.0.0.1:$PORT" ANTHROPIC_API_KEY="proxy" \
  CLAUDE_CODE_MAX_OUTPUT_TOKENS="$QWEN_MAX_OUTPUT_TOKENS" \
  API_TIMEOUT_MS=600000 \
  claude ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} ${MCP_ARGS[@]+"${MCP_ARGS[@]}"} "$@"
claude_status=$?

# 7. PR backstop — the Stop hook this session never got.
#
# Runs the same auto-pr-push.sh the harness would have run, in the directory the
# session worked in (this wrapper never cd's). It is safe to call unconditionally:
# it no-ops unless the repo's origin owner is on the allowlist, the branch is off
# trunk, has commits ahead, and has no open PR — and hook-common.sh refuses any
# repo with `rs21` in its name outright. It backgrounds and disowns its own work,
# so it does not delay the prompt coming back.
#
# stdin is /dev/null on purpose: the script reads a hook JSON payload from stdin
# and falls back to the current directory when it gets nothing, which is exactly
# the behaviour wanted here.
AUTO_PR="$HOME/projects/Screddyice/claude-code-harness/scripts/hooks/auto-pr-push.sh"
if [ -x "$AUTO_PR" ]; then
  HARNESS_PR_OWNERS="${HARNESS_PR_OWNERS:-teamnebula-ai screddyice}" \
    "$AUTO_PR" </dev/null >/dev/null 2>&1 || true
fi

exit "$claude_status"
